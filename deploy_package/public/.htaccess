<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# -------------------------------------------------------
# PHP Error Configuration (Production Hardening)
# -------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_reporting E_ALL
</IfModule>
# For PHP-FPM / FastCGI environments, add to php.ini instead:
# display_errors = Off
# log_errors = On

# -------------------------------------------------------
# Block Access to Sensitive File Types
# -------------------------------------------------------
<FilesMatch "\.(sql|log|bak|sh|env|ini|conf|lock)$">
    Require all denied
</FilesMatch>

# -------------------------------------------------------
# Enable Gzip Compression (Performance)
# -------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -------------------------------------------------------
# Browser Caching for Static Assets (Performance)
# -------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Images – cache for 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Versioned CSS/JS (files include ?v= query string) – 1 year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fonts – 1 year
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache versioned CSS/JS for 1 year (immutable since we use ?v= versioning)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Cache images for 1 year
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # Do NOT cache PHP output (dynamic pages)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

